<?xml version="1.0" encoding="utf-8"?>
<!-- El servidor corre en la red local por HTTP: se permite tráfico sin cifrar. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
